{
  // Cloudflare's "Workers with static assets" flow, which is what the dashboard offers now
  // instead of Pages. There is no Worker script: `assets` with no `main` serves the built
  // directory straight from the edge, so this file only has to say where the build landed.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fen2dxf",
  "compatibility_date": "2026-09-01",
  // Publish to <name>.<account subdomain>.workers.dev. Without this the Worker deploys with
  // no route attached and the dashboard reports "no active routes" -- it is running, there is
  // just no URL pointing at it. Note this is NOT a *.pages.dev address: that is the Pages
  // product, and a Worker never gets one.
  "workers_dev": true,
  "assets": {
    "directory": "./dist"
  }
}
